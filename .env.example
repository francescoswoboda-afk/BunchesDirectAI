STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
PORT=4242
FRONTEND_URL=http://localhost:4242

# Put real secrets in .env.local (ignored by git)

# Email sending (orders + contact form)
# Recommended: Brevo. Create an API key in Brevo (SMTP & API -> API keys) and verify the
# bunches-direct.com domain there, then set:
BREVO_API_KEY=
# Sender address: must be on the domain verified in Brevo
EMAIL_FROM=orders@bunches-direct.com
EMAIL_FROM_NAME=Bunches Direct

# Fallback when BREVO_API_KEY is empty: SMTP (e.g. a Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# Optional: override recipient for order emails.
# If empty, the server will use the email from contact.html (Get in Touch form),
# then fallback to SMTP_USER.
ORDER_TO_EMAIL=

# Optional: path to an existing Excel template workbook.
# Example: ORDER_EXCEL_TEMPLATE=assets/order-template.xlsx
ORDER_EXCEL_TEMPLATE=

# Availability upload admin
AVAILABILITY_ADMIN_PASSWORD=
# Use an unguessable path, example: /family-availability-admin-4f8d2e
AVAILABILITY_ADMIN_PATH=/family-availability-admin
AVAILABILITY_PDF_MAX_BYTES=8388608

# Orders: links in the order emails point to this site (set to http://localhost:4242 to test locally)
PUBLIC_SITE_URL=https://bunches-direct.com
# Where saved orders are kept (Fly sets /data/orders). Default: .orders in the app folder
ORDERS_DATA_DIR=
